# Local-first mode needs no cloud credentials.
KAIRO_MODE=local
KAIRO_API_KEY=local-kairo-development-key
KAIRO_LOCAL_DB=.kairo/chroma

# Optional, only used when KAIRO_MODE=cloud.
# GOOGLE_API_KEY=
# CHROMADB_API_KEY=
# TENANT_ID=
# DATABASE_ID=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_JUDGE_MODEL=gemini-2.5-flash
